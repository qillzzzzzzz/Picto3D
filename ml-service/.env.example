# Salin menjadi .env lalu sesuaikan token/device bila diperlukan.
YOLO_MODEL=best.pt
YOLO_DEVICE=cpu
YOLO_IMAGE_SIZE=960
YOLO_IOU_THRESHOLD=0.45
YOLO_MAX_DETECTIONS=50
YOLO_MIN_BOX_AREA_RATIO=0.00015
YOLO_MAX_BOX_AREA_RATIO=0.95
YOLO_AUTO_ENHANCE=true
YOLO_ADAPTIVE_RETRY=true
YOLO_RETRY_CONFIDENCE=0.42
YOLO_RETRY_TTA=false
YOLO_HALF=false
YOLO_ALLOWED_CLASSES=
YOLO_EXPECTED_CLASSES=eraser,wrinkle,correction tape,spidol,brush pen,drawing pen,board marker,pencil,stabilo,ruler,protractor,paper clip,binder clip,scissors,term,tape
YOLO_STRICT_CLASSES=true
YOLO_API_TOKEN=change-this-token
MAX_IMAGE_BYTES=4194304
