# Gunakan bobot hasil training sendiri, biasanya runs/detect/train/weights/best.pt.
YOLO_MODEL=weights/best.pt
YOLO_DEVICE=cpu
YOLO_IMAGE_SIZE=640
YOLO_IOU_THRESHOLD=0.45
YOLO_MAX_DETECTIONS=50
YOLO_MIN_BOX_AREA_RATIO=0.0005
YOLO_AUTO_ENHANCE=true
YOLO_HALF=false
# Opsional: batasi kelas dengan ID/nama, dipisahkan koma.
YOLO_ALLOWED_CLASSES=
# Opsional: validasi kelas hasil training saat startup.
YOLO_EXPECTED_CLASSES=bolpoin,gunting,botol,kubus
YOLO_STRICT_CLASSES=true
YOLO_API_TOKEN=change-this-token
YOLO_SERVICE_URL=http://127.0.0.1:8001
YOLO_CONNECT_TIMEOUT=3
YOLO_REQUEST_TIMEOUT=20
MAX_IMAGE_BYTES=4194304
